programa {
  funcao inicio() {
    inteiro a,b,c
  escreva("insira o primeiro valor: ")
  leia(a)

  escreva("insira o segundo valor: ")
  leia(b)

  escreva("insira o terceiro valor: ")
  leia(c)

  se (a > b){
  escreva(a,", o maior valor inserido! ")
  }senao se(b > c){
   escreva(b, ", o maior valor inserido!")
  }senao{
   escreva(c,", o maior valor inserido!")
  }


  
  }
}
