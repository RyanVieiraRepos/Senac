programa {
  funcao inicio() {
    inteiro a, b ,c , inicio, fim
   
    escreva("Tabuada do : ")
    leia(a)
    
    escreva("A tabuada começará pelo número: ")
    leia(b)

    escreva("E terminará no: ")
    leia(c)

    inicio = b
    fim = c
    inteiro conta = a * b

    enquanto(b <= c){

      escreva(a * b, "\n")
    
    
      b++

    }

    
    }

 
  }

