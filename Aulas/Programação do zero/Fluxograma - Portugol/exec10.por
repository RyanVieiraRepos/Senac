programa {
  funcao inicio() {
    inteiro a, b ,c , inicio, fim
   
    escreva("Tabuada do : ")
    leia(a)
    
    escreva("A tabuada começará pelo número: ")
    leia(b)

    escreva("E terminará no: ")
    leia(c)

    inicio = b
    fim = c
   

    enquanto(inicio <= fim){
      
      escreva(a * )
      inicio++
    }

 
  }
}
