programa {
  funcao inicio() {
    inteiro a,b,c
   
   escreva("Insira o valor de A : ")
   leia(a)

   escreva("Insira o valor de B : ")
   leia(b)

   limpa()


   escreva("variáveis antes da troca :\n")
   escreva ("A = ", a ," B = ",b,"\n")

   
 
  c = a // c = a, a continua com o mesmo valor  
  a = b 
  b = c

   escreva("valores depois da troca \n")

   escreva("A = ",a , " B = ",b)
  }
}
